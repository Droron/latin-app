 "grammar": [
  {
   "title": "Plural: -a becomes -ae, est becomes sunt",
   "rules": [
    "nominative-plural"
   ],
   "body": "One girl is *puella*; two or more are *puellae*. When the subject is plural, *est* 'is' becomes *sunt* 'are'.\n\nAdjectives follow their noun into the plural too: *puella bona* → *puellae bonae*. So *Puellae sunt bonae* = 'The girls are good.'\n\nTwo singular subjects joined by *et* are also plural: *Iūlia et Cornēlia sunt bonae* 'Julia and Cornelia are good.'\n\n*sed* 'but' joins two statements: *Terra magna est, sed via parva est.*",
   "table": {
    "head": [
     "one",
     "more than one"
    ],
    "laCols": [
     0,
     1
    ],
    "rows": [
     [
      "puella",
      "puellae"
     ],
     [
      "via longa",
      "viae longae"
     ],
     [
      "est",
      "sunt"
     ],
     [
      "Via longa est.",
      "Viae longae sunt."
     ]
    ]
   }
  }
 ],
